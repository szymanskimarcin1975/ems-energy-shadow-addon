#!/usr/bin/env python3
"""Fixed Supervisor Core operations only; never print tokens or response bodies."""
import json,os,sys,urllib.request
if len(sys.argv)!=3 or sys.argv[1]!='core' or sys.argv[2] not in ('info','check','stop','start'):sys.exit(2)
a=sys.argv[2]
try:
 req=urllib.request.Request('http://supervisor/core/'+a,headers={'Authorization':'Bearer '+os.environ['SUPERVISOR_TOKEN']},method='GET' if a=='info' else 'POST')
 class NoRedirect(urllib.request.HTTPRedirectHandler):
  def redirect_request(self,*args,**kwargs):raise ValueError()
 http=urllib.request.build_opener(urllib.request.ProxyHandler({}),NoRedirect())
 with http.open(req,timeout=80) as response:
  body=json.loads(response.read(65537))
  if response.status!=200 or body.get('result')!='ok':sys.exit(1)
 sys.exit(0)
except Exception:
 # A write may already have happened. Parent maps 70 to UNKNOWN, never retries.
 sys.exit(70)
